{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2017",
    "lib": ["es2017"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "noImplicitAny": false,
    "types": ["@figma/plugin-typings"]
  }
}
